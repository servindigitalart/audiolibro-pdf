---
import '@/styles/globals.css';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noIndex?: boolean;
  /** Additional JSON-LD schema object(s) injected alongside the base SoftwareApplication schema */
  extraSchema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Sonoro – Turn PDFs into Audiobooks Instantly',
  description = 'Convert any PDF into a professional audiobook in seconds. Perfect for students, professionals, and lifelong learners. Try free.',
  ogImage = '/og.png',
  canonical,
  noIndex = false,
  extraSchema,
} = Astro.props;

const appUrl =
  import.meta.env.PUBLIC_SITE_URL ??
  import.meta.env.PUBLIC_APP_URL ??
  'https://sonoro.app';

const gscVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ?? '';

// Strip tracking params (?ref=, ?utm_*) from canonical to prevent duplicate-URL indexing
const _rawUrl = new URL(canonical ?? Astro.url.href);
['ref', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach(
  (p) => _rawUrl.searchParams.delete(p),
);
const canonicalUrl = _rawUrl.toString();

const baseSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Sonoro',
      applicationCategory: 'ProductivityApplication',
      operatingSystem: 'Web',
      description,
      url: appUrl,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
    {
      '@type': 'Organization',
      name: 'Sonoro',
      url: appUrl,
      logo: { '@type': 'ImageObject', url: `${appUrl}/favicon.svg` },
    },
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#FDFCFB" />

    <!-- Inter font — preconnect + async load (no render-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      id="font-inter"
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      media="all"
    />
    <script is:inline>
      (function(){var l=document.getElementById('font-inter');if(l){l.media='print';l.onload=function(){l.media='all';l.onload=null;}}})();
    </script>

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noIndex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    }
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalUrl} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={`${appUrl}${ogImage}`} />
    <meta property="og:site_name"   content="Sonoro" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={`${appUrl}${ogImage}`} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Base structured data (SoftwareApplication + Organization) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(baseSchema)} />

    <!-- Page-specific structured data (FAQPage, etc.) -->
    {extraSchema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(extraSchema)} />
    )}
  </head>

  <body class="bg-sonoro-white text-sonoro-900 antialiased">
    <slot />

    <!-- Scroll reveal observer — GPU-composited, stagger-aware -->
    <script is:inline>
      (function () {
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
                observer.unobserve(e.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.reveal').forEach(function (el) { observer.observe(el); });
      })();
    </script>

    <!-- Attribution capture: referral code + UTM params on first landing -->
    <script>
      import { captureReferralCode, captureUtmParams, getOrCreateVisitorId } from '@/lib/referral';
      import { trackReferralClick } from '@/lib/api/client';

      const params = new URLSearchParams(window.location.search);
      const ref = params.get('ref');
      if (ref) {
        captureReferralCode();
        const visitorId = getOrCreateVisitorId();
        trackReferralClick(ref, visitorId || undefined, window.location.pathname);
      }
      captureUtmParams();
    </script>
  </body>
</html>
