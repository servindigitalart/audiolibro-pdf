---
import BaseLayout from './BaseLayout.astro';
import DashboardSidebar from '@/components/nav/DashboardSidebar.astro';
import DashboardHeader from '@/components/nav/DashboardHeader.astro';
import DashboardBottomNav from '@/components/nav/DashboardBottomNav.astro';
import MiniPlayer from '@/components/dashboard/MiniPlayer';
import { fetchAccountOverview } from '@/lib/api/server';

export interface Props {
  title?: string;
  activeNav?: string;
}

const { title = 'Dashboard – Sonoro', activeNav = 'dashboard' } = Astro.props;
const token = (Astro.locals as any).token as string;

let overview = null;
try {
  overview = await fetchAccountOverview(token);
} catch {
  // Non-fatal; sidebar renders without usage data
}

const user = overview?.user ?? null;
const usage = overview?.usage ?? null;
---

<BaseLayout title={title} noIndex={true}>
  <div class="flex h-screen overflow-hidden bg-sonoro-surface">
    <!-- Sidebar — desktop only (md+) -->
    <DashboardSidebar activeNav={activeNav} user={user} usage={usage} />

    <!-- Main content area -->
    <div class="flex flex-1 flex-col overflow-hidden">
      <DashboardHeader user={user} />

      <!--
        Bottom padding accounts for layered fixed elements:
          mobile: bottom nav (52px) + mini-player (~64px) + safe area = ~140px → pb-36
          desktop: mini-player only (~64px) → pb-24
      -->
      <main class="flex-1 overflow-y-auto p-4 md:p-6 lg:p-8 pb-36 md:pb-24">
        <slot />
      </main>
    </div>
  </div>

  <!-- Bottom nav — mobile only, sits at z-30 -->
  <DashboardBottomNav activeNav={activeNav} />

  <!--
    Sticky mini-player — client-only, z-40.
    On mobile it uses bottom-14 to float above the bottom nav (14 × 4px = 56px ≥ 52px nav height).
    On desktop it uses bottom-0.
  -->
  <MiniPlayer client:load />
</BaseLayout>
