---
export const prerender = true;

import MarketingLayout from '@/layouts/MarketingLayout.astro';
import LandingTemplate from '@/components/marketing/LandingTemplate.astro';

const siteUrl = import.meta.env.SITE_URL ?? import.meta.env.PUBLIC_SITE_URL ?? 'https://sonoro.app';

const benefits = [
  {
    icon: 'M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 0 1 6.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129',
    title: 'Native Spanish voices',
    body: 'Choose from Castilian and Latin American accents. Our neural voices carry natural rhythm and intonation — not a flat bilingual TTS.',
  },
  {
    icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
    title: 'Spanish PDFs, perfectly read',
    body: 'Sonoro handles Spanish language quirks — ñ, accents, proper nouns, dialogue punctuation — that trip up generic TTS tools.',
  },
  {
    icon: 'M9.663 17h4.673M12 3v1m6.364 1.636-.707.707M21 12h-1M4 12H3m1.343-5.657-.707-.707m2.828 9.9a5 5 0 1 1 7.072 0l-.548.547A3.374 3.374 0 0 0 14 18.469V19a2 2 0 1 1-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
    title: 'Great for language learners too',
    body: 'Learning Spanish? Listen to texts you already understand while seeing the written form. Immersive input, your way.',
  },
];

const steps = [
  { n: 1, title: 'Upload your Spanish PDF', body: 'Any Spanish-language PDF works — literature, news articles, academic papers, business documents.' },
  { n: 2, title: 'Pick a Spanish voice', body: 'Preview Castilian or Latin American voices before generating. Adjust speed to your liking.' },
  { n: 3, title: 'Listen or download', body: 'Stream instantly in your browser or download the MP3 for offline listening on any device.' },
];

const faqs = [
  {
    q: 'Does Sonoro support Spanish PDFs?',
    a: 'Yes. Sonoro fully supports Spanish-language content, including proper handling of accented characters (á, é, í, ó, ú, ñ, ü) and Spanish punctuation conventions.',
  },
  {
    q: 'What Spanish accents are available?',
    a: 'Sonoro offers voices with both Castilian (Spain) and Latin American accents. You can preview each voice before converting.',
  },
  {
    q: 'Can I use this to learn Spanish?',
    a: 'Absolutely. Listening to Spanish text read aloud by a native-sounding voice is an excellent comprehension input method. Upload texts at your reading level and listen repeatedly.',
  },
  {
    q: 'What about mixed-language documents?',
    a: 'For best results, use documents written primarily in one language. Sonoro performs best when the document language matches the selected voice language.',
  },
  {
    q: 'Is there a word or page limit?',
    a: 'The free plan covers a generous number of pages per month. Paid plans accommodate longer books, full course packets, and heavy professional use.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<MarketingLayout
  title="Spanish PDF to Audio — Natural Voice Conversion | Sonoro"
  description="Convert Spanish PDFs to audio with natural Castilian and Latin American voices. Perfect for Spanish learners and native speakers. Free to start."
  canonical={`${siteUrl}/spanish-pdf-to-audio`}
  extraSchema={faqSchema}
>
  <LandingTemplate
    heading="Spanish PDF to Audio — Natural Voice, Instant Conversion"
    tagline="Turn Spanish PDFs into clear, natural audio using native-sounding voices. Whether you're reading Spanish literature, news, or academic texts — Sonoro reads it for you."
    badge="Spanish · Castilian & Latin American voices"
    {benefits}
    {steps}
    {faqs}
    ctaText="Convert a Spanish PDF — free"
  />
</MarketingLayout>
