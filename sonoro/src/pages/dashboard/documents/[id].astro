---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import AudioPlayer from '@/components/dashboard/AudioPlayer';
import CoverPanel from '@/components/dashboard/CoverPanel';
import { fetchDocument } from '@/lib/api/server';
import { fmtDate, fmtFileSize, fmtDuration } from '@/lib/utils';
import type { Chapter, Document } from '@/lib/api/types';

const token = (Astro.locals as any).token as string;
const { id } = Astro.params;

if (!id) return Astro.redirect('/dashboard/documents');

let doc: Document | null = null;
let chapters: Chapter[] = [];

try {
  const BASE = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000/api/v1';
  [doc, chapters] = await Promise.all([
    fetchDocument(token, id),
    fetch(`${BASE}/documents/${id}/chapters`, {
      headers: { Authorization: `Bearer ${token}` },
    }).then(r => r.ok ? r.json() : []).catch(() => []),
  ]);
} catch {
  return Astro.redirect('/dashboard/documents');
}

const title     = doc?.title || doc?.filename || 'Document';
const duration  = doc?.metadata?.duration_seconds;
const pages     = doc?.metadata?.pages;
const chapLen   = chapters.length || doc?.metadata?.chapters;
const autoplay  = Astro.url.searchParams.get('autoplay') === '1';
const BASE_URL  = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000/api/v1';
---

<DashboardLayout title={`${title} – Sonoro`} activeNav="documents">

  <!-- Breadcrumb -->
  <nav class="flex items-center gap-1.5 text-xs text-sonoro-muted mb-6" aria-label="Breadcrumb">
    <a href="/dashboard" class="hover:text-sonoro-900 transition-colors">Dashboard</a>
    <svg class="w-3 h-3 opacity-40" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M4.5 2l3 4-3 4" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <a href="/dashboard/documents" class="hover:text-sonoro-900 transition-colors">Library</a>
    <svg class="w-3 h-3 opacity-40" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M4.5 2l3 4-3 4" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="text-sonoro-700 truncate max-w-[200px]">{title}</span>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-5 gap-6 items-start">

    <!-- Player — main column -->
    <div class="lg:col-span-3">
      <AudioPlayer
        chapters={chapters}
        documentTitle={title}
        documentId={id}
        coverUrl={doc?.cover_url}
        author={doc?.author}
        autoplay={autoplay}
        client:load
      />
    </div>

    <!-- Sidebar -->
    <div class="lg:col-span-2 space-y-4">

      <!-- Title card with inline edit -->
      <div class="card-base p-5">
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-xs font-semibold text-sonoro-500 uppercase tracking-wider">Audiobook title</h2>
          <button
            id="edit-title-btn"
            class="text-xs text-sonoro-amber-dark font-medium hover:underline"
            aria-label="Edit title"
          >
            Edit
          </button>
        </div>

        <!-- Read-only state -->
        <p id="title-display" class="text-sm font-semibold text-sonoro-900 leading-snug">{title}</p>

        <!-- Edit form (hidden by default) -->
        <form id="title-form" class="hidden">
          <div class="flex gap-2">
            <input
              id="title-input"
              type="text"
              value={title}
              class="input-base flex-1 text-sm"
              maxlength="200"
              aria-label="Audiobook title"
            />
            <button type="submit" class="btn-primary btn-sm shrink-0">Save</button>
            <button type="button" id="cancel-title-btn" class="btn-outline btn-sm shrink-0">✕</button>
          </div>
          <p id="title-status" class="text-xs text-sonoro-muted mt-1.5 min-h-[1rem]"></p>
        </form>
      </div>

      <!-- Cover card -->
      {doc && (
        <div class="card-base p-5">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-xs font-semibold text-sonoro-500 uppercase tracking-wider">Cover art</h2>
          </div>
          <div class="flex items-start gap-4">
            <!-- Cover image — updated by CoverPanel via data-cover-img -->
            <div class="relative shrink-0">
              <div class="w-20 h-28 rounded-xl overflow-hidden shadow-card">
                {doc.cover_url ? (
                  <img
                    data-cover-img
                    src={doc.cover_url}
                    alt="Audiobook cover"
                    class="w-full h-full object-cover"
                  />
                ) : (
                  <div
                    class="w-full h-full flex items-center justify-center text-white/60 text-[10px] font-bold"
                    style="background: linear-gradient(145deg, #D97706, #92400E)"
                    aria-hidden="true"
                  >
                    {title.split(' ').slice(0,2).map((w: string) => w[0]?.toUpperCase()).join('')}
                  </div>
                )}
              </div>
            </div>

            <!-- CoverPanel React island handles upload, find cover, reset -->
            <CoverPanel
              documentId={id}
              initialCoverUrl={doc.cover_url}
              client:load
            />
          </div>
        </div>
      )}

      <!-- Document info card -->
      <div class="card-base p-5">
        <h2 class="text-xs font-semibold text-sonoro-500 uppercase tracking-wider mb-4">Document info</h2>
        <dl class="space-y-3">
          {[
            ...(doc?.author              ? [{ label: 'Author',        value: doc.author }] : []),
            ...(doc?.subtitle            ? [{ label: 'Subtitle',      value: doc.subtitle }] : []),
            ...(doc?.isbn                ? [{ label: 'ISBN',          value: doc.isbn }] : []),
            { label: 'Original file', value: doc?.filename?.replace(/^document_[a-f0-9-]+\./, '') ?? doc?.filename ?? '—' },
            { label: 'Size',          value: doc ? fmtFileSize(doc.file_size) : '—' },
            { label: 'Pages',         value: pages ?? '—' },
            { label: 'Parts',         value: chapLen ?? '—' },
            { label: 'Duration',      value: duration ? fmtDuration(duration) : '—' },
            { label: 'Uploaded',      value: doc ? fmtDate(doc.upload_date) : '—' },
          ].map(({ label, value }) => (
            <div class="flex justify-between gap-4 items-baseline">
              <dt class="text-xs text-sonoro-muted shrink-0">{label}</dt>
              <dd class="text-xs font-medium text-sonoro-800 text-right truncate max-w-[160px]">{value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <!-- Status indicator -->
      {doc && doc.status !== 'completed' && (
        <div class={`card-base p-4 flex items-start gap-3 ${doc.status === 'failed' ? 'border-red-200' : 'border-amber-200/70'}`}>
          <div class={`flex h-7 w-7 shrink-0 items-center justify-center rounded-full mt-0.5 ${doc.status === 'failed' ? 'bg-red-50' : 'bg-amber-50'}`}>
            {doc.status === 'failed' ? (
              <svg class="w-3.5 h-3.5 text-red-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0zm-8-5a.75.75 0 0 1 .75.75v4.5a.75.75 0 0 1-1.5 0v-4.5A.75.75 0 0 1 10 5zm0 10a1 1 0 1 0 0-2 1 1 0 0 0 0 2z" clip-rule="evenodd"/>
              </svg>
            ) : (
              <svg class="w-3.5 h-3.5 text-amber-500 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-opacity=".2"/>
                <path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
              </svg>
            )}
          </div>
          <div>
            <p class="text-xs font-semibold text-sonoro-900 mb-0.5">
              {doc.status === 'failed' ? 'Processing failed' : 'Processing…'}
            </p>
            <p class="text-xs text-sonoro-muted leading-relaxed">
              {doc.status === 'failed'
                ? (doc.error_message ?? 'Something went wrong. Try uploading again.')
                : 'Your audiobook is being generated. Refresh in a moment.'}
            </p>
          </div>
        </div>
      )}

      <!-- Download button -->
      {doc?.status === 'completed' && (
        <a
          href={`${BASE_URL}/documents/${id}/audio`}
          class="btn-outline w-full justify-center gap-2.5"
          aria-label="Download audiobook MP3"
        >
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M3 17a1 1 0 0 1 1-1h12a1 1 0 1 1 0 2H4a1 1 0 0 1-1-1zm3.293-7.707a1 1 0 0 1 1.414 0L9 10.586V3a1 1 0 1 1 2 0v7.586l1.293-1.293a1 1 0 1 1 1.414 1.414l-3 3a1 1 0 0 1-1.414 0l-3-3a1 1 0 0 1 0-1.414z" clip-rule="evenodd"/>
          </svg>
          Download MP3
        </a>
      )}

      <!-- Back link -->
      <a
        href="/dashboard/documents"
        class="flex items-center gap-2 text-xs text-sonoro-muted hover:text-sonoro-900 transition-colors"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 3L5 8l5 5"/>
        </svg>
        Back to library
      </a>
    </div>
  </div>
</DashboardLayout>

<script is:inline define:vars={{ docId: id, BASE_URL }}>
  const token = () => document.cookie.split('; ').find(r => r.startsWith('access_token='))?.split('=')[1] ?? '';
  const authHeaders = () => ({ 'Content-Type': 'application/json', Authorization: `Bearer ${token()}` });

  // ── Title edit ──────────────────────────────────────────────────────────────
  const editBtn   = document.getElementById('edit-title-btn');
  const titleDisp = document.getElementById('title-display');
  const titleForm = document.getElementById('title-form');
  const titleInp  = document.getElementById('title-input');
  const cancelBtn = document.getElementById('cancel-title-btn');
  const titleStat = document.getElementById('title-status');

  editBtn?.addEventListener('click', () => {
    titleDisp?.classList.add('hidden');
    titleForm?.classList.remove('hidden');
    titleInp?.focus();
    titleInp?.select();
  });

  cancelBtn?.addEventListener('click', () => {
    titleForm?.classList.add('hidden');
    titleDisp?.classList.remove('hidden');
  });

  titleForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const val = titleInp?.value?.trim();
    if (!val || !titleStat) return;
    titleStat.textContent = 'Saving…';
    try {
      const res = await fetch(`${BASE_URL}/documents/${docId}/title`, {
        method: 'PATCH',
        headers: authHeaders(),
        body: JSON.stringify({ display_title: val }),
      });
      if (!res.ok) throw new Error('Failed');
      if (titleDisp) titleDisp.textContent = val;
      titleForm.classList.add('hidden');
      titleDisp?.classList.remove('hidden');
      titleStat.textContent = '';
    } catch {
      titleStat.textContent = 'Could not save. Please try again.';
    }
  });

  // Cover upload/reset/find-cover handled by the CoverPanel React island.
</script>
